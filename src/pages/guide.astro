import fs from 'node:fs';
import path from 'node:path';
import Layout from '../layouts/Layout.astro';

const metaPath = path.resolve(process.cwd(), 'public/data/toc/meta.json');
const meta = JSON.parse(fs.readFileSync(metaPath, 'utf-8'));
const books = meta.books as Array<{
  code: string;
  name: string;
  full_name: string;
  thai: string;
  pitaka: string;
  url: string;
  from_abbrv: string;
  to_abbrv: string;
}>;

